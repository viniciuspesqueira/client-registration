# Copie para .env e preencha com os dados do seu banco.
# Em produção, as mesmas variáveis ficam no Vercel (Settings > Environment
# Variables), e o projeto precisa de um Redeploy depois de alterá-las.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=crud

# Opcional: CA em PEM ou base64, usado para validar o certificado do servidor.
# Deixe VAZIO quando o provedor usa certificado autoassinado e não fornece um
# ca.pem (é o caso da Clever Cloud): a conexão continua criptografada, apenas
# sem validar a cadeia.
# Atenção: um CA de outro provedor aqui quebra a conexão com
# HANDSHAKE_SSL_ERROR. Ao trocar de banco, troque ou esvazie este valor.
MYSQL_SSL_CA=

# Depois de configurar, crie as tabelas com:  npm run db:migrate
